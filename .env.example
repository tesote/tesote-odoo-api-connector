# .env.example — established by dz-runner setup mode.
# NAMES only. Copy to `.env`, fill each value there, and never commit that file.

# Live integration lanes hitting the real tesote.com API v2 (account import, transaction sync, webhook subscription); the  (optional)
TESOTE_API_TOKEN=

# Base URL of the tesote.com API v2 instance for live integration checks; the unit gate mocks all HTTP. (optional)
TESOTE_API_URL=

# Services these commands need running:
#   postgres — docker compose service `db` (postgres:15-alpine, user odoo/odoo, dev DB tesote_dev) — needed only for the Docker dev lan
#   odoo — docker compose service `odoo` built from Dockerfile.dev (FROM odoo:18.0) with the module volume-mounted; image build cur
#   tesote-api — external — tesote.com API v2 (staging), reached only with a bearer token; fully mocked in the unit gate
