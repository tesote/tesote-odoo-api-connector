<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu -->
    <menuitem
        id="menu_tesote_root"
        name="Tesote"
        sequence="50"
        web_icon="tesote_connector,static/description/icon.png"/>

    <!-- Configuration Menu -->
    <menuitem
        id="menu_tesote_configuration"
        name="Configuration"
        parent="menu_tesote_root"
        sequence="100"/>

    <!-- API Configuration Menu - Opens singleton configuration -->
    <menuitem
        id="menu_tesote_backend"
        name="API Settings"
        parent="menu_tesote_configuration"
        action="action_tesote_backend_open"
        sequence="10"/>

    <!-- Account Mapping Menu -->
    <menuitem
        id="menu_tesote_account_mapping"
        name="Account Mapping"
        parent="menu_tesote_configuration"
        action="action_tesote_account_mapping"
        sequence="15"
        groups="account.group_account_manager"/>

    <!-- Sync Logs Menu -->
    <menuitem
        id="menu_tesote_sync_log"
        name="Sync Logs"
        parent="menu_tesote_configuration"
        action="action_tesote_sync_log"
        sequence="20"/>

    <!-- Webhook Configuration Menu -->
    <menuitem
        id="menu_tesote_webhook_config"
        name="Webhook Settings"
        parent="menu_tesote_configuration"
        action="action_tesote_webhook_config_open"
        sequence="30"
        groups="account.group_account_manager"/>

    <!-- Data Menu -->
    <menuitem
        id="menu_tesote_data"
        name="Financial Data"
        parent="menu_tesote_root"
        sequence="10"/>

    <!-- Accounts Menu -->
    <menuitem
        id="menu_tesote_account"
        name="Accounts"
        parent="menu_tesote_data"
        action="action_tesote_account"
        sequence="10"/>

    <!-- Transactions Menu -->
    <menuitem
        id="menu_tesote_transaction"
        name="Transactions"
        parent="menu_tesote_data"
        action="action_tesote_transaction"
        sequence="20"/>

    <!-- Webhooks Menu -->
    <menuitem
        id="menu_tesote_webhook"
        name="Webhooks"
        parent="menu_tesote_root"
        sequence="40"
        groups="account.group_account_manager"/>

    <!-- Webhook Events Dashboard -->
    <menuitem
        id="menu_tesote_webhook_events"
        name="Events Dashboard"
        parent="menu_tesote_webhook"
        action="action_tesote_webhook_event_dashboard"
        sequence="10"/>

    <!-- Recent Webhook Events -->
    <menuitem
        id="menu_tesote_webhook_recent"
        name="Recent Events"
        parent="menu_tesote_webhook"
        action="action_tesote_webhook_event_recent"
        sequence="20"/>

    <!-- Failed Webhook Events -->
    <menuitem
        id="menu_tesote_webhook_failed"
        name="Failed Events"
        parent="menu_tesote_webhook"
        action="action_tesote_webhook_event_failed"
        sequence="30"/>

    <!-- Reports Menu -->
    <menuitem
        id="menu_tesote_reports"
        name="Reports"
        parent="menu_tesote_root"
        sequence="50"/>

    <!-- Transaction Analysis -->
    <menuitem
        id="menu_tesote_transaction_analysis"
        name="Transaction Analysis"
        parent="menu_tesote_reports"
        action="action_tesote_transaction"
        sequence="10"/>

    <!-- Balance Dashboard -->
    <menuitem
        id="menu_tesote_balance_dashboard"
        name="Balance Dashboard"
        parent="menu_tesote_reports"
        action="action_tesote_balance_dashboard"
        sequence="20"/>
</odoo>
