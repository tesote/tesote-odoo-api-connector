<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_tesote_account_form" model="ir.ui.view">
        <field name="name">tesote.account.form</field>
        <field name="model">tesote.account</field>
        <field name="arch" type="xml">
            <form string="Tesote Account" create="false" delete="false">
                <header>
                    <button name="import_transactions" type="object" string="Import Transactions" class="btn-primary" icon="fa-download"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_transactions" icon="fa-exchange">
                            <field string="Transactions" name="transaction_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_invoices" icon="fa-file-text-o">
                            <field string="Invoices" name="invoice_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="tesote_id" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Account Information">
                            <field name="backend_id" readonly="1"/>
                            <field name="bank_name"/>
                            <field name="legal_entity_name"/>
                            <field name="balance"/>
                            <field name="currency_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Transaction Sync">
                            <field name="sync_date"/>
                            <field name="sync_cursor"/>
                        </group>
                    </group>
                    <group>
                        <group string="Invoice Sync">
                            <field name="invoice_sync_date"/>
                            <field name="invoice_sync_cursor"/>
                        </group>
                        <group string="Tesote Timestamps">
                            <field name="tesote_created_at" readonly="1"/>
                            <field name="tesote_updated_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recent Transactions">
                            <field name="transaction_ids" readonly="1"/>
                        </page>
                        <page string="Technical" groups="base.group_no_one">
                            <group>
                                <field name="create_date" readonly="1"/>
                                <field name="write_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_tesote_account_tree" model="ir.ui.view">
        <field name="name">tesote.account.tree</field>
        <field name="model">tesote.account</field>
        <field name="arch" type="xml">
            <list string="Tesote Accounts" create="false">
                <field name="name"/>
                <field name="tesote_id"/>
                <field name="bank_name"/>
                <field name="balance"/>
                <field name="currency_id"/>
                <field name="transaction_count"/>
                <field name="sync_date"/>
                <field name="active"/>
                <field name="create_date"/>
                <button name="import_transactions" type="object" string="Sync" icon="fa-sync"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tesote_account_search" model="ir.ui.view">
        <field name="name">tesote.account.search</field>
        <field name="model">tesote.account</field>
        <field name="arch" type="xml">
            <search string="Search Tesote Accounts">
                <field name="name"/>
                <field name="tesote_id"/>
                <field name="bank_name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Bank" name="group_bank" context="{'group_by': 'bank_name'}"/>
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tesote_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">tesote.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tesote_account_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No accounts synchronized yet
            </p>
            <p>
                Import accounts from your Tesote backend.
            </p>
        </field>
    </record>
</odoo>
