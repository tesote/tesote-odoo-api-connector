#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_header() {
    echo -e "${BLUE}================================================${NC}"
    echo -e "${BLUE}    Odoo Enterprise Addons Setup                ${NC}"
    echo -e "${BLUE}================================================${NC}"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_info() {
    echo -e "${YELLOW}ℹ${NC} $1"
}

# Default path
DEFAULT_PATH="$HOME/odoo/enterprise-18.0"
BRANCH="18.0"
REPO_URL="https://github.com/odoo/enterprise.git"

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
SIBLING_ENTERPRISE="$(dirname "$PROJECT_DIR")/enterprise"

print_header
echo ""

# Check if git is available
if ! command -v git &> /dev/null; then
    print_error "Git is not installed. Please install git first."
    exit 1
fi

# Check for enterprise folder as sibling directory
if [ -d "$SIBLING_ENTERPRISE" ] && [ -d "$SIBLING_ENTERPRISE/.git" ]; then
    print_success "Found enterprise folder at sibling directory: $SIBLING_ENTERPRISE"

    # Verify it's the Odoo enterprise repo
    cd "$SIBLING_ENTERPRISE"
    REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
    CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || echo "")
    cd - > /dev/null

    if [[ "$REMOTE_URL" == *"odoo/enterprise"* ]] && [[ "$CURRENT_BRANCH" == "$BRANCH" ]]; then
        print_success "Valid Odoo Enterprise repository on branch $BRANCH"
        read -p "Use this path? (Y/n) " -n 1 -r
        echo ""
        if [[ ! $REPLY =~ ^[Nn]$ ]]; then
            INSTALL_PATH="$SIBLING_ENTERPRISE"
            print_info "Using sibling enterprise directory"
        else
            print_info "Choose a different path below"

            while true; do
                read -p "Enter path (or press Enter for default) [$DEFAULT_PATH]: " INSTALL_PATH
                INSTALL_PATH="${INSTALL_PATH:-$DEFAULT_PATH}"
                if [ ${#INSTALL_PATH} -eq 1 ]; then
                    print_error "Invalid path. Single character paths are not allowed."
                    echo ""
                    continue
                fi
                break
            done
        fi
    else
        print_error "Found directory at $SIBLING_ENTERPRISE but it's not a valid Odoo Enterprise repo"
        print_info "Expected: odoo/enterprise repository (branch $BRANCH)"
        print_info "Found: $REMOTE_URL (branch $CURRENT_BRANCH)"
        echo ""
        print_info "Choose installation path below"

        while true; do
            read -p "Enter path (or press Enter for default) [$DEFAULT_PATH]: " INSTALL_PATH
            INSTALL_PATH="${INSTALL_PATH:-$DEFAULT_PATH}"
            if [ ${#INSTALL_PATH} -eq 1 ]; then
                print_error "Invalid path. Single character paths are not allowed."
                echo ""
                continue
            fi
            break
        done
    fi
elif [ -d "$SIBLING_ENTERPRISE" ]; then
    print_error "Found directory at $SIBLING_ENTERPRISE but it's not a git repository"
    echo ""
    print_info "Choose installation path below"

    while true; do
        read -p "Enter path (or press Enter for default) [$DEFAULT_PATH]: " INSTALL_PATH
        INSTALL_PATH="${INSTALL_PATH:-$DEFAULT_PATH}"
        if [ ${#INSTALL_PATH} -eq 1 ]; then
            print_error "Invalid path. Single character paths are not allowed."
            echo ""
            continue
        fi
        break
    done
else
    print_error "Could not find enterprise Odoo at sibling directory: $SIBLING_ENTERPRISE"
    echo ""
    print_info "Where do you want to install Odoo Enterprise addons?"
    echo ""

    # Loop until we get a valid path
    while true; do
        read -p "Enter path (or press Enter for default) [$DEFAULT_PATH]: " INSTALL_PATH
        INSTALL_PATH="${INSTALL_PATH:-$DEFAULT_PATH}"

        # Validate path isn't a single character (common mistake: Y/N/y/n)
        if [ ${#INSTALL_PATH} -eq 1 ]; then
            print_error "Invalid path. Single character paths are not allowed."
            echo ""
            continue
        fi

        break
    done
fi

# Check if directory already exists
if [ -d "$INSTALL_PATH" ]; then
    print_info "Directory already exists: $INSTALL_PATH"

    # Validate it's a git repository
    if [ ! -d "$INSTALL_PATH/.git" ]; then
        print_error "Directory exists but is not a git repository: $INSTALL_PATH"
        print_info "Please remove it or choose a different path."
        exit 1
    fi

    read -p "Update existing installation? (y/N) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        print_info "Updating enterprise addons..."
        if ! cd "$INSTALL_PATH"; then
            print_error "Failed to access directory: $INSTALL_PATH"
            exit 1
        fi
        git pull
        if [ $? -eq 0 ]; then
            print_success "Enterprise addons updated!"
        else
            print_error "Failed to update. Check your credentials and network connection."
            exit 1
        fi
        cd - > /dev/null
    else
        print_info "Skipping download."
    fi
else
    # Create parent directory if needed
    mkdir -p "$(dirname "$INSTALL_PATH")"

    print_info "Cloning Odoo Enterprise (branch $BRANCH)..."
    print_info "You may be prompted for your GitHub credentials."
    echo ""

    git clone "$REPO_URL" "$INSTALL_PATH" --branch "$BRANCH" --depth 1

    if [ $? -eq 0 ]; then
        print_success "Enterprise addons downloaded!"
    else
        print_error "Failed to clone. Make sure you have access to the Odoo enterprise repository."
        print_info "You need a GitHub account linked to an Odoo.com account with enterprise access."
        exit 1
    fi
fi

echo ""

# Update .env file
ENV_FILE=".env"
if [ -f "$ENV_FILE" ]; then
    # Check if ENTERPRISE_PATH already exists
    if grep -q "^ENTERPRISE_PATH=" "$ENV_FILE"; then
        print_info "ENTERPRISE_PATH already set in .env"
        read -p "Update to new path? (y/N) " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            sed -i.bak "s|^ENTERPRISE_PATH=.*|ENTERPRISE_PATH=$INSTALL_PATH|" "$ENV_FILE"
            rm -f "$ENV_FILE.bak"
            print_success "Updated ENTERPRISE_PATH in .env"
        fi
    elif grep -q "^#.*ENTERPRISE_PATH=" "$ENV_FILE"; then
        # Uncomment and set the path
        sed -i.bak "s|^#.*ENTERPRISE_PATH=.*|ENTERPRISE_PATH=$INSTALL_PATH|" "$ENV_FILE"
        rm -f "$ENV_FILE.bak"
        print_success "Enabled ENTERPRISE_PATH in .env"
    else
        # Add new line
        echo "ENTERPRISE_PATH=$INSTALL_PATH" >> "$ENV_FILE"
        print_success "Added ENTERPRISE_PATH to .env"
    fi
else
    print_error ".env file not found"
fi

echo ""
print_success "Setup complete!"
echo ""
print_info "Next steps:"
echo "  1. Restart Docker: docker compose down && docker compose up -d"
echo "  2. Enterprise modules will appear in the Apps list"
echo ""
